# se-knowledge — environment configuration (example)
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# All values are OPTIONAL. If unset, the scripts fall back to sensible
# relative defaults (./docs, ./pdfs, ./manifest.json) next to the project
# root, so the tool works out of the box after `npm install`.
#
# Paths may be absolute or relative. Do NOT commit your real `.env`.

# Directory where crawled / synced markdown docs are read and written.
# Used by: crawl.js, build-manifest.js, clean.js, validate.js, sync.js
# SE_DOCS_DIR=./docs

# Directory where source PDFs are downloaded.
# Used by: crawl-pdfs.js, sync-pdfs.js
# SE_PDF_DIR=./pdfs

# Directory where markdown extracted from PDFs is written.
# Used by: crawl-pdfs.js, sync-pdfs.js
# SE_PDF_DOCS_DIR=./docs/pdfs

# Path to the generated manifest index.
# Used by: build-manifest.js, sync.js, sync-pdfs.js
# SE_MANIFEST=./manifest.json
